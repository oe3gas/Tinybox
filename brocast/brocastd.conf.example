; Vorlage. Kopieren nach brocastd.conf und pro PC anpassen
; (PC1: mode = listener, PC2: mode = station + callsign).
; brocastd.conf selbst ist nicht im Repo (.gitignore).

; brocastd – Konfiguration
; Spezifikation: https://claude.ai/code/artifact/bf4b91a7-7807-42d7-b72e-5739d9c257bd

[brocastd]
mode       = listener          ; station (senden + empfangen) oder listener (nur empfangen)
callsign   =                   ; AX.25-Rufzeichen der Station, getrennt von der Mailbox (OE3GAS-1)
data_dir   = data
dictionary = brocast-core.yaml
log_level  = INFO

; CR70: jeder Funkwert hat EINEN Besitzer – über AGW direwolf.conf, über KISS der
; kisshub. brocastd liest Funkrate und TXDELAY von dort und meldet beim Start die Quelle.
; Beispiele: MANUAL.md Abschnitt 2.5. Die alte Sektion [direwolf] gilt weiter (mit Hinweis).

[radio]
interface     = agw           ; agw (empfohlen) oder kiss – Unterschied: README, „Verbindung zu Direwolf“

[agw]                         ; nur bei interface = agw
; direwolf_conf = E:\direwolf ; Ordner oder Datei: AGWPORT, MODEM, TXDELAY daraus
channel       = 0             ; Direwolf-Funkkanal
; host        = 127.0.0.1     ; Standard; nur wenn Direwolf auf einem anderen PC läuft
; port        = 8000          ; Standard: AGWPORT aus direwolf.conf (TinyBox nutzt denselben Port)
reconnect_sec = 5

[kiss]                        ; nur bei interface = kiss
port          = 8101          ; kisshub (Funkwerte aus seinem Status) – oder Direwolf-KISSPORT 8001

[station]
ingest_host        = 127.0.0.1
ingest_port        = 8090
token              =           ; leer = kein Token nötig
path               =           ; Digipeater, z. B. WIDE1-1 (leer = lokal)
airtime_percent    = 15        ; Obergrenze Kanalbelegung durch brocast
airtime_window_min = 10
; baud / txdelay_ms            ; entfallen: aus direwolf.conf bzw. kisshub (nur zum Überschreiben)
burst_frames       = 4         ; höchstens n Frames pro Aussendung (PTT-Zyklus), 0 = keine Aufteilung
burst_gap_s        = 3         ; Pause nach jeder Aussendung, Kanal frei für andere Stationen
repeat_minutes     = 0,2,5,10  ; neue Revision sofort, dann nach 2, 5, 10 min ...
max_interval_min   = 30        ; ... danach alle 30 min
aging              = 24:120    ; ... und ab 24 h Alter nur noch alle 120 min.
                               ; Mehrere Stufen mit Komma, 0 min = gar nicht mehr senden
                               ; (die Seite bleibt, eine neue Revision weckt sie wieder),
                               ; z. B.  aging = 24:120, 168:0   ; leer = keine Alterung
wire_format        = 2         ; 2 = Umschlag einmal, Inhalt gepackt in Fragmenten (Standard)
                               ; 1 = eine vollständige Seite je Frame (alt, ca. doppelte
                               ; Sendezeit; nur für Vergleichsmessungen)
compress           = yes       ; Format 2: Inhalt mit Preset-Wörterbuch packen
                               ; (zdict/brocast-zdict-<Gen>.bin, muss auf beiden Seiten gleich sein)
withdraw_repeats   = 3
id_auto_start      = 24        ; Seiten 1..23 (1 Byte) bleiben für feste Seiten
max_subpages       = 40        ; Format 2: höchstens so viele Fragmente je Seite
dict_source        = Mailbox OE3GAS-1, Befehl DICT   ; wird mit der Dictionary-Version angekündigt (leer = nein)
dict_broadcast_hours = 24     ; Dictionary gepackt über Funk senden, alle n Stunden (0 = aus)

[console]
color     = auto              ; Farben im Konsolenfenster: auto | yes | no

[logging]
log_dir   = logs              ; Programm-Log, eine Datei pro Start (leer = nur Konsole)
txlog_dir = logs              ; Sendeprotokoll (Station): Sendeprotokoll_<JJJJ-MM>.txt,
                              ; jeder gesendete Frame mit Zeit (UTC); wird nie automatisch gelöscht

[listener]
web_host  = 127.0.0.1         ; 0.0.0.0 = aus dem LAN/WLAN erreichbar (nur mit allow_lan = yes)
web_port  = 7733              ; Listener-Oberfläche: http://127.0.0.1:7733/
allow_lan = no                ; yes = Oberfläche im LAN, OHNE Anmeldung – Firewall auf Heimnetz beschränken!
lan_names =                   ; zusätzliche Rechnernamen für den Browser, z. B. pc2.fritz.box
                              ; (IP-Adresse und Rechnername gehen bei allow_lan = yes immer)
