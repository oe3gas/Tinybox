; brocast – Seitenschema (Entwurf, Dictionary-Version 1)
; Lebendes Dokument: https://claude.ai/code/artifact/bf4b91a7-7807-42d7-b72e-5739d9c257bd
; Stand: 2026-10-02 (Dictionary v1 eingefroren, Prüfsumme 1b082f65)
; Eine Seite = ein Frame: kodierte Seite hoechstens 240 Bytes.

brocast-page = {
  dv    => uint,
  id    => uint,
  ? rev   => uint,
  ? org   => callsign,
  t     => uint,
  ? exp   => uint,
  typ   => page-type,
  ? flg   => uint .bits page-flags,
  ? ti    => tstr .size (0..40),
  ? txt   => tstr,
  ? to    => callsign / uint / tstr,
  ? area  => tstr,
  ? pos   => position,
  ? sym   => tstr .size 2,
  ? lnk   => [+ page-ref],
  ? ref   => page-ref,
  ? pri   => 0..3,
  ? lang  => uint,
  ? cat   => [+ uint / tstr .size (1..20)],   ; Kern-Rubrik oder eigene als Text
  ? blk   => [+ block],
  ? dat   => { * int => any },
  ? src   => [+ any],
  ? crit  => [+ int],
  ? sub   => [uint, uint],               ; Unterseite [n, gesamt]
  * int => any                      ; unbekannte Keys erlaubt
}

; Umschlag-Keys
dv = 0  id = 1  rev = 2  org = 3  t = 4  exp = 5  typ = 6  flg = 7
ti = 8  txt = 9  to = 10  area = 11  pos = 12  sym = 13  lnk = 14
ref = 15  pri = 16  lang = 17  cat = 18  blk = 19  dat = 20  src = 21  crit = 22  sub = 23

page-type = &(text: 0, wx: 1, tlm: 2, msg: 3, ack: 4, obj: 5, node: 6,
              dx: 7, alert: 8, index: 9, dict: 10) / uint
page-flags = &(withdrawn: 0, test: 1, exercise: 2, reply-wanted: 3)

callsign = tstr .regexp "([A-Z0-9]{1,4}/)?[A-Z0-9]{3,8}(/[A-Z0-9]{1,4})?(-[0-9]{1,2})?"  ; z. B. DL/OE3GAS/P, OE3GAS/MM, OE3GAS-10
position = [int, int, ? int, ? uint]  ; lat, lon (Grad * 10^5), Hoehe m, Unschaerfe m
page-ref = [callsign, uint / tstr, ? uint]  ; org, id, rev

; Bausteine (negative Keys)
block = {
  ? k => uint, ? x => tstr, ? v => int / float / tstr, ? u => uint,
  ? n => uint / tstr, ? dt => int, ? bpos => position, ? href => page-ref,
  ? rows => [* [* any]], ? hdr => [* any], ? lo => int / float,
  ? hi => int / float, ? st => uint, ? acc => int / float, ? sc => int,
  * int => any
}
k = -1  x = -2  v = -3  u = -4  n = -5  dt = -6  bpos = -7  href = -8
rows = -9  hdr = -10  lo = -11  hi = -12  st = -13  acc = -14  sc = -15

; Themen-Dictionary Wetter (typ 1): lokale Keys in dat
; Einheiten/Skalierung laut Dictionary: temp 0,1 °C; hum %; qnh 0,1 hPa; wdir Grad;
; wspd/gust 0,1 m/s; r1h/r24h 0,1 mm
wx-data = {
  ? temp => int, ? hum => uint, ? qnh => uint, ? wdir => 0..360,
  ? wspd => uint, ? gust => uint, ? r1h => uint, ? r24h => uint,
  ? rday => uint, ? qfe => uint, ? dew => int, ? sol => uint, ? uv => uint, ? snow => uint,
  ; ab Version 2:
  ? tmin => int, ? tmax => int, ? gmax => uint, ? ptnd => int, ? r10m => uint, ? qff => uint,
  ? gust10 => uint,
  * int => any
}
temp = 0  hum = 1  qnh = 2  wdir = 3  wspd = 4  gust = 5  r1h = 6  r24h = 7
rday = 8  qfe = 9  dew = 10  sol = 11  uv = 12  snow = 13
tmin = 14  tmax = 15  gmax = 16  ptnd = 17  r10m = 18  qff = 19  gust10 = 20

; Themen-Dictionary Dictionary-Ankündigung (typ 10)
dict-data = {
  ? version => uint, ? hash => tstr .size 8, ? source => tstr,
  ; Dictionary über Funk (fest im Programm, Bootstrap): Teil n/m steht in sub
  ? zdata => bstr, ? zlen => uint,
  ; nur in der Ankündigung: Dictionary kommt alle n Stunden über Funk
  ? zint => uint,
  * int => any
}
version = 0  hash = 1  source = 2  zdata = 3  zlen = 4  zint = 5
