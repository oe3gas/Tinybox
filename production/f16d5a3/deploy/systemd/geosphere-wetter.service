[Unit]
Description=GeoSphere weather bulletin into the TinyBox inbox
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tinybox
Group=tinybox
WorkingDirectory=/opt/tinybox
# inbox in RAM (/run/tinybox/eingang, see tmpfiles-tinybox.conf); messages go to the journal
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/tinybox/geosphere_station.py --tinybox /run/tinybox/eingang
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
