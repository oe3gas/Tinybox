# Vorlage. Kopieren nach tinybox.conf und pro PC anpassen.
# tinybox.conf selbst ist nicht im Repo (.gitignore).

# TinyBox configuration
# Relative paths are relative to this file.

[station]
mailbox_call = OE3GAS-1        # callsign + SSID the mailbox answers on
sysop_call   = OE3GAS          # this call (any SSID) gets sysop rights
sysop_via_radio = no           # no: sysop rights only locally (callsigns
                               # on the air are not authenticated)
haddress     =                 # hierarchical address of this mailbox, without SSID,
                               # e.g. OE3GAS.#NOE.AUT.EU (needed for [forward])
qth          =                 # place name shown in R: lines, e.g. Hollabrunn
freq         =                 # MHz of the radio port, e.g. 144.800 - for the ADIF export of
                               # the connection log (empty: no FREQ/BAND in the .adi)
locator      =                 # your locator for the ADIF export, e.g. JN88EP

[direwolf]
agw_host        = 127.0.0.1    # Direwolf runs on the same PC
agw_port        = 8000         # AGWPORT in direwolf.conf
agw_radio_port  = 0            # Direwolf channel (0 = first radio)
reconnect_sec   = 5
paclen          = 256          # bytes per packet sent (= PACLEN in direwolf.conf; 256 is
                               # the AX.25 default, 128 doubled the frames of every picture)
max_outstanding = 6            # packets handed to Direwolf ahead of the acknowledgements;
                               # set EMAXFRAME 6 in direwolf.conf, see PLANUNG.md 12.10a
# Link quality - needs the TinyBox Direwolf fork (AGW 'Q'), PLANUNG.md section 14
quality_poll_sec      = 30     # ask Direwolf every n seconds (0 = off)
quality_window_frames = 50     # window per direction: last n frames ...
quality_window_min    = 30     # ... but at most the last n minutes
quality_min_frames    = 20     # fewer frames: no result yet (grey bars)
quality_steps         = 5, 10, 20, 35, 50   # loss in % up to which 5/4/3/2/1 bars,
                               # above the last one a single red bar

[radio]
interface = agw                # agw = Direwolf does AX.25 (above); kiss = TinyBox does
                               # AX.25 itself over a KISS TNC (PLANUNG.md section 15)

[kiss]                         # only with interface = kiss
host        = 127.0.0.1        # kisshub, or Direwolf's KISS port for tests
port        = 8101             # 8101 = kisshub (TNC), 8001 = Direwolf's KISSPORT
channel     = 0                # KISS port number of the radio
air_baud    = 1200             # radio bit rate - TinyBox estimates its own air time
txdelay_ms  = 300              # as set in the TNC
status_port = 8102             # kisshub status for the web GUI (CR41), 0 = off

[ax25]                         # only with interface = kiss; missing values: see below
version      = 2.2             # 2.2: SABME/SREJ/XID, falls back to 2.0 by itself; 2.0: SABM only
# paclen     = 128             # default: [direwolf] paclen
# maxframe   = 4               # window modulo 8 (1..7), default: [direwolf] max_outstanding
maxframe_ext = 7               # window modulo 128 (v2.2); 7 is plenty at 1200 Bd
srej         = yes
n2           = 10              # retries
t1_min_sec   = 3               # T1 adapts itself between these limits
t1_max_sec   = 30
t2_sec       = 1.5             # acknowledge after the other station's burst
t3_sec       = 300             # check an idle link after n seconds

[mailbox]
welcome_enabled      = yes
welcome_text         = Amateur radio use only. No encryption, no business traffic.
third_party          = yes     # yes: everybody may write to everybody
max_users            = 3
max_msg_bytes        = 8192
idle_timeout_min     = 10
bulletin_expire_days = 30      # 0 = keep bulletins forever; a rubric may have its own (| days in [rubrics])

[telnet]
enabled = yes                  # local test port without radio
host    = 127.0.0.1            # loopback only
port    = 6300

[web]
enabled = yes                  # sysop web GUI in the browser
host    = 127.0.0.1            # loopback only
port    = 8080                 # login link is shown in the TinyBox window

[console]
enabled = yes                  # sysop console in the TinyBox window
monitor = yes                  # show live session traffic there (toggle: MON)

[storage]
data_dir = data

[logging]
level     = INFO               # DEBUG, INFO, WARNING, ERROR
monitor   = yes                # include session traffic in the log file
log_dir   =                    # empty = no log file. Otherwise an existing,
                               # writable folder, e.g. logs or D:\Logs\Tinybox.
                               # One file per day: tinybox-<date>.log, a restart
                               # appends to it (console command LOG shows the path)
keep_days = 14                 # delete log files older than this (0 = keep all)
debug     =                    # extra DEBUG for single components, e.g. agw,fwd
                               # (level stays as above for the rest). Known:
                               # agw bus brocast chat cmd core fwd inbox linkq
                               # news notify session store svc sync sysop telnet
                               # web - or all. At runtime: LOG DEBUG agw

[brocast]
dict_file  = brocast/brocast-core.yaml  # DICT command; empty = not offered
publish    = yes                         # report bulletins to brocastd (never private mail)
ingest_url = http://127.0.0.1:8090/api/v1
token      =                             # same as [station] token in brocastd.conf
max_bytes  = 4096                        # longer bulletins are cut, with a hint "R n"
destinations =                           # empty = all bulletins, e.g. DX WX ALL
rubrics    =                             # extra DEST:rubric pairs, e.g. FUCHS:Fuchsjagd
sync_min   = 60                          # full sync with brocastd every n minutes
alert_destinations = WARN                # these bulletins become warning pages in brocast

[inbox]
enabled  = yes                 # scripts drop *.txt here, TinyBox makes bulletins
dir      = eingang             # processed: eingang/erledigt, rejected: eingang/fehler
poll_sec = 10

[beacon]
# CR48: a UI frame from the mailbox call every interval_min minutes. With
# mail_list = yes the calls with new private mail are appended:
#   TinyBox OE3GAS-1 - connect for mail and chat - Mail for: OE1ABC OE3TEC
enabled      = no
interval_min = 30              # 5 ... 1440
dest         = BEACON          # destination call of the UI frame (e.g. BEACON, ID, MAIL)
path         =                 # up to 2 digipeaters, e.g. WIDE1-1 (empty = direct)
text         = TinyBox {call} - connect for mail and chat   # {call} = mailbox_call, {qth}; no # or ;
mail_list    = yes             # append "Mail for: CALL CALL ..." when there is new mail
first_after_sec = 60           # the first beacon this long after the start

[client]
mail_notify   = yes            # TinyBox clients: a UI frame to TBMAIL ("OE3ABC 2 new")
                               # tells the addressee about new private mail, without connecting

[chat]
enabled       = yes            # command C: chat boards for logged-in users
history_lines = 20             # max lines per history request (/H n, client)
max_line      = 200            # max characters per chat line
image_max     = 8k             # small pictures in the chat (TinyBox client, CR12):
                               # max bytes per picture (1k ... 15k), 0 = no pictures

[chat_boards]
# Fixed boards, set by the sysop. One line per board:
#   NAME = keep [noimg] description
# NAME: 1-8 letters/digits. keep: live (nothing stored) or how long the
# history is kept, e.g. 12h or 7d (max 365d). Order = order in the list.
# noimg: no pictures in this board (live boards never have any).
TREFF = 7d    General meeting point
DX    = 24h   DX spots and news
TECH  = 30d   Technical questions
RUNDE = live  Live round, nothing is stored

[chat_motd]
# Message of the day per board (optional), shown when entering it. Max 120
# characters, no # or ; (they start a comment). Change: edit + RESTART.
# The client fetches the text only when it changed.
#TREFF = Welcome! Net every Sunday 19:00 local on this frequency.

[rubrics]
# Bulletin rubrics, set by the sysop (CR19, docs/client-change-requests.md).
# One line per rubric:
#   NAME = description      accepted: users may write, forwarding is taken
#   NAME = - [note]         refused: forwarding is declined
# NAME: 1-6 letters/digits. ALL is always accepted. Order = order in the client.
# Without any line here every rubric is free (as before).
# Users, scripts (inbox folder) and MQTT write only to ALL and accepted rubrics;
# the sysop is free. TBNEWS (client news) is a system rubric, never for users.
# A partner mailbox offering an unknown rubric: the first bulletin is kept held
# and the sysop gets a mail, further ones wait; enter the rubric here as
# accepted or refused and RESTART.
# The accepted rubrics (with description) also go to brocastd with every full
# sync; brocastd sends them as the station's rubric index page, so listeners
# know new rubrics before the first page and drop removed ones (PLANUNG 6f).
# Optional "| days" at the end: bulletins of this rubric are kept that many
# days (CR40), 0 = forever. Without it [mailbox] bulletin_expire_days applies.
#ALL     = To everybody                 | 14
#WX      = Weather and warnings         | 3
#DX      = DX news
#HUMOR   = -  not wanted here

[forward]
enabled  = no                  # exchange mail with other mailboxes (module from F2 on);
                               # no = standalone mailbox, @ addresses only for bulletins
bid_days = 60                  # BIDs are remembered this long; older mail is held
aliases  =                     # short names for areas, e.g. ALLOE:AUT EUROPA:EU
publish_to_brocast = no        # yes: bulletins from partner mailboxes also go to brocastd
listen_host = 127.0.0.1        # incoming TCP forwards (partners call us);
listen_port = 0                # 0 = none. Not loopback: every TCP partner needs a password.
                               # Login: TinyBox asks "Callsign:" and "Password:".

# One section per neighbouring mailbox (call without SSID). Examples:
#
# [partner.OE3GAS]             # over the air via Direwolf
# transport = agw
# ax25_call = OE3GAS           # call to connect to / that calls us (may have an SSID)
# via       =                  # digipeaters / nodes, e.g. OE3XNR
# haddress  = OE3GAS.#OOE.AUT.EU
# routes    = WW               # personal mail: address patterns, WW = default route
# areas     = WW EU AUT        # bulletins: flood areas, * = all
# protocol  = fbb              # b1 (compressed, with restart), fbb or ascii (W0RLI);
#                              # LinBPQ compresses whenever both sides have F: use b1 or ascii
# timeout   = 300              # seconds without data
# auto      = no               # call by itself when mail waits (default: tcp yes, agw no -
#                              # unattended forwarding over the air: check the licence first)
# interval_min = 0             # also call every n minutes to fetch mail (0 = only to send)
# window    =                  # only call in this time window (local time), e.g. 22:00-06:00
# retry_min = 10               # after a failed call wait this long
#
# [partner.OE3XAB]             # over TCP (HAMNET), e.g. LinBPQ FBBPORT
# transport = tcp
# host      = 44.143.0.1
# port      = 8011
# login     = OE3XTC | password  # lines sent after connecting, separated by |
# password  =                    # what this partner sends when it calls us
# routes    = WW
# areas     = WW EU AUT

[mqtt]
enabled       = no             # milestone M5
host          = 127.0.0.1
port          = 8883
tls           = yes
client_id     = tinybox-oe3gas
username      = tinybox
password_file = secrets/mqtt.pw
topic_root    = tinybox/OE3GAS-1
