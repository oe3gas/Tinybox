# Text im Repo mit LF, Windows bekommt beim Auschecken CRLF
* text=auto
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
*.odt  binary
*.db   binary
*.png  binary
*.bin  binary
# Feeder-Pi: alles laeuft auf dem Pi (sh, systemd), daher immer LF
feederpi/** text eol=lf
