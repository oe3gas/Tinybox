# Text im Repo mit LF, Windows bekommt beim Auschecken CRLF
* text=auto
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
*.odt  binary
*.db   binary
*.png  binary
*.bin  binary
*.ico  binary
# Feeder-Pi: alles laeuft auf dem Pi (sh, systemd), daher immer LF
feederpi/** text eol=lf
# modem73: Patch und Build-Skript immer mit LF (patch bricht sonst ab)
tools/modem73/** text eol=lf
