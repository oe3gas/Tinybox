; kisshub - owns the KISS TNC and shares it over KISS-TCP (PLANUNG.md section 15)
; Copy to kisshub.conf and adjust. TinyBox: [radio] interface = kiss, [kiss] port = 8101

[tnc]
profile   = pk232          ; pk232 | tm-d710 | th-d74 | th-d75 | tnc2-kiss | generic
                           ; | vara-fm | vara-hf (see below)
transport = serial         ; serial | tcp (TNC behind a network serial server)
device    = COM3           ; Windows COM3, Raspberry Pi /dev/ttyUSB0, Bluetooth /dev/rfcomm0
serial_baud = 9600         ; PC <-> TNC (PK-232: its TBAUD; 9600 as pk232py uses it)
; host = 127.0.0.1         ; only with transport = tcp
; port = 4001
reconnect_sec = 10
exit_kiss_on_stop = yes    ; on Ctrl+C: leave KISS, so pk232py / a terminal finds cmd:
; VARA FM / HF (experiment, docs/kiss-mode-konzept.md 8c): profile = vara-fm,
; transport = tcp, host = 127.0.0.1, port = 8100 ("KISS interface" in VARA Setup).
; VARA takes only UI frames as KISS type 0; connected mode goes through VARA's
; type 2 ("Generic Data") - the station on the other side needs kisshub too.
; vara_tunnel = connected  ; no | connected (UI stays type 0) | all
; [kiss] send_params must stay "no": VARA would send KISS commands 1/2 on the air
; init_lines = AWLEN 8 | PARITY 0 | RESTART | ... | KISS ON | HOST ON
;              replaces the profile's init; the last line enters KISS

[kiss]
air_baud    = 1200         ; radio bit rate
txdelay_ms  = 300          ; sent to the TNC as KISS TXDELAY
persist     = 63           ; KISS P (0..255)
slottime_ms = 100
send_params = yes          ; no: keep what is set in the TNC
max_lead_ms = 1500         ; at most this much air time queued in the TNC, so
                           ; acknowledgements overtake long frames (priorities)

[server]
listen = 127.0.0.1         ; loopback only
port   = 8101              ; not 8001: that is Direwolf's KISS port
status_port = 8102         ; status for the TinyBox web GUI (JSON, loopback only), 0 = off

[log]
level = INFO               ; DEBUG shows every byte of the TNC dialog
file  =                    ; e.g. kisshub.log
trace = no                 ; yes: every byte to/from the TNC in hex (console: LOG TRACE)
status_every_sec = 600
links_file = kisshub-links.jsonl   ; CR67: one JSON line per finished AX.25 link (quality),
                           ; the same for PK-232 and VARA - compare runs; empty = off

[vara]                     ; only with profile vara-fm / vara-hf (CR67)
monitor  = no              ; yes: listen on VARA's command port - read only, sends nothing.
                           ; Gives real PTT times per burst, waiting before PTT, BUSY share,
                           ; SN per received frame. FIRST TIME WITH SOMEBODY AT THE RADIO:
                           ; older VARA versions left the PTT keyed with KISS + command port.
; host   = 127.0.0.1       ; default: [tnc] host
cmd_port = 8300            ; VARA Setup "Command"
sn_window_ms = 1500        ; an SN line belongs to a frame received this close to it

