; kisshub - owns the KISS TNC / modem and shares it over KISS-TCP (PLANUNG.md section 15)
; Copy to kisshub.conf and adjust. TinyBox / client: [radio] interface = kiss, [kiss] port = 8101
; CR70: this is the ONE place for the radio values (bit rate, TXDELAY, AX.25 recommendation).
; TinyBox and the client read them from kisshub's status query - nothing to copy there.
; Example configurations: MANUAL.md section 2.4
;
; ONE FILE FOR ALL TNCs: start with -p to pick the profile, e.g.
;   kisshub.bat -p pk232      kisshub.bat -p vara-fm      kisshub.bat -p direwolf
; -p overrides [tnc] profile. [<section>.<profile>] (e.g. [kiss.pk232] or
; [tnc.vara-fm]) overrides a section for that profile only, {profile} in the
; [log] file names becomes the profile name. kisshub -h (or -?) shows the help.

[tnc]
profile   = pk232          ; default when started without -p: pk232 | tm-d710 | tnc7multi |
                           ; th-d74 |
                           ; th-d75 | tnc2-kiss | generic | vara-fm | vara-hf | direwolf
; transport = serial       ; serial | tcp - default: tcp for vara-* / direwolf, else serial
device    = COM3           ; serial only: Windows COM3, Raspberry Pi /dev/ttyUSB0
serial_baud = 9600         ; PC <-> TNC (PK-232: its TBAUD; 9600 as pk232py uses it)
; rtscts    =              ; RTS/CTS hardware flow control - default: yes for tm-d710
;                          ; (the radio paces kisshub over CTS), no for the others
; host = 127.0.0.1         ; tcp only
; port =                   ; tcp only - default: vara-* 8100, direwolf KISSPORT (else 8001)
reconnect_sec = 10
exit_kiss_on_stop = yes    ; on Ctrl+C: leave KISS, so pk232py / a terminal finds cmd:
; smack = no               ; KISS with CRC-16 (SMACK) - default: yes for tnc7multi, no else
; init_lines = AWLEN 8 | PARITY 0 | RESTART | ... | KISS ON | HOST ON
;              replaces the profile's init; the last line enters KISS
;
; profile = direwolf: Direwolf's KISS port. kisshub reads KISSPORT, MODEM, TXDELAY,
; PACLEN, MAXFRAME, EMAXFRAME from direwolf.conf (a folder or the file itself):
direwolf_conf = C:\direwolf ; only used by profile direwolf
;
; profile = vara-fm / vara-hf (docs/kiss-mode-konzept.md 8c/8d): VARA Setup
; "KISS interface" on (port 8100). VARA takes only UI frames as KISS type 0;
; connected mode goes through VARA's type 2 ("Generic Data") - the station on the
; other side needs kisshub too. Air values are measured (350 bit/s, 2700 ms).
; vara_tunnel = connected  ; no | connected (UI stays type 0) | all
; vara_bundle_ms = 0       ; >0: tunnelled frames within this time go as ONE type-2 frame
;                          ; (experiment: no gain with VARA FM Narrow)
; vara_bundle_max = 4000   ; bytes per bundle (VARA takes up to 5000)

[kiss]                     ; ALL OPTIONAL - the profile (or direwolf.conf) has the defaults
; air_baud    =            ; vara-fm 350 | direwolf MODEM | others 1200
;                          ; tm-d710: 1200 or 9600, sent to the TNC as HBAUD
; txdelay_ms  =            ; vara-fm 2700 | direwolf TXDELAY | others 300
; persist     = 63         ; hardware TNC only (sent as KISS P)
; slottime_ms = 100
; send_params =            ; default per profile: yes for TNCs, no for vara-* / direwolf
;                          ; (must stay no with VARA: it would send KISS commands 1/2 on air)
; max_lead_ms =            ; at most this much air time queued in the TNC, so acks overtake
;                          ; long frames - vara 12000 | others 1500

[ax25]                     ; OPTIONAL: change the recommendation TinyBox / client get
; paclen / maxframe / maxframe_ext / n2 / t1_min_sec / t1_max_sec / t2_sec / t3_sec
;                          ; default 1200 Bd: 256 / 4 / 7 / - / 3 / 30 / 1.5
;                          ; vara-fm: 256 / 4 / 4 / - / 18 / 90 / 0.3

[server]
port   = 8101              ; not 8001: that is Direwolf's KISS port
                           ; loopback only; status query (JSON) on port + 1

[console]
color = auto               ; colours in the console window: auto | yes | no

[log]
level = INFO               ; DEBUG shows every byte of the TNC dialog
file  = kisshub-{profile}.log   ; empty = console only; {profile} = the profile name,
                           ; so every TNC gets its own log (the start lines name it)
trace = no                 ; yes: every byte to/from the TNC in hex (console: LOG TRACE)
status_every_sec = 600
links_file = kisshub-links-{profile}.jsonl ; CR67: one JSON line per finished AX.25 link,
                           ; the same for PK-232 and VARA - compare runs; empty = off

[update]
check = yes                ; once a day ask GitHub for a new TinyBox release (PLANUNG 24):
                           ; one warning line in the log, nothing is downloaded or installed

[vara]                     ; only with profile vara-fm / vara-hf (CR67)
monitor  = no              ; yes: listen on VARA's command port - read only, sends nothing.
                           ; Ignored (with a hint) when another profile is started.
                           ; Gives real PTT times per burst, waiting before PTT, BUSY share,
                           ; SN per received frame. FIRST TIME WITH SOMEBODY AT THE RADIO:
                           ; older VARA versions left the PTT keyed with KISS + command port.
; host   = 127.0.0.1       ; default: [tnc] host
cmd_port = 8300            ; VARA Setup "Command"
sn_window_ms = 1500        ; an SN line belongs to a frame received this close to it

; Per-profile overrides - only what differs, e.g.
; [tnc.tm-d710]            ; Kenwood TM-D710: kisshub.bat -p tm-d710
; device = COM7            ; TNC key -> PACKET first; kisshub sends HBAUD <air_baud> /
;                          ; KISS ON / RESTART, on stop C0 FF C0 + KISS OFF
; [kiss.tm-d710]
; air_baud = 9600          ; 1200 (default) or 9600 - goes to the TNC as HBAUD
; [tnc.tnc7multi]          ; TNC7multi: kisshub.bat -p tnc7multi - rotary switch on 1k2
; device = COM8            ; (9k6 for 9600 Bd); USB = FTDI virtual COM port
; serial_baud = 115200     ; USB default; RS232 (null modem cable): 38400
; [kiss.tnc7multi]         ; defaults = the TNC's own: TXDELAY 150, P 64, SlotTime 50
; air_baud = 9600          ; only with the switch on 9k6 - kisshub cannot set it
; [kiss.pk232]
; txdelay_ms = 400
; [tnc.vara-fm]
; host = 192.168.1.20      ; VARA on another PC
