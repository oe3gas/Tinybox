# TinyBox client - copy to tbclient.conf and adapt.
# Start with tbclient.bat, then open http://<this PC>:7744 in a browser (also on the phone).
# WICHTIG / IMPORTANT: OE3GAS ist das Rufzeichen des Autors - ueberall durch
# das eigene Rufzeichen ersetzen. Replace OE3GAS with your own callsign everywhere.

[station]
mycall       = OE3GAS          # your call, with SSID if wanted (OE3GAS-9 = mobile)
locator      =                 # your locator for the ADIF export of the connection log, e.g. JN88EP
                               # (the frequency is asked when the client starts)

[tinybox]
call         = OE3GAS-1        # your TinyBox (mailbox); other stations: "Connect to" in the top bar
ui           = auto            # chat events as UI frames: auto = if the TinyBox is heard directly
auto_connect = no              # connect when the client starts
telnet_host  = 127.0.0.1       # only with interface = telnet
telnet_port  = 6300

[radio]
interface    = agw             # agw = radio via Direwolf; kiss = TNC / VARA via kisshub, the
                               # client's own AX.25 (no Direwolf needed); telnet = TinyBox test
                               # port (same PC)
# CR70: every radio value has ONE owner - over AGW direwolf.conf, over KISS kisshub.
# The client reads them from there and shows at start where each one came from.
# Example configurations: MANUAL.md section 2.

[agw]                          # only with interface = agw
# direwolf_conf = C:\direwolf  # Direwolf folder or its direwolf.conf: AGWPORT, MODEM (estimate)
channel      = 0               # Direwolf channel
# host       = 127.0.0.1       # default; only if Direwolf runs on another PC
# port       = 8000            # default: AGWPORT from direwolf.conf, else 8000

[kiss]                         # only with interface = kiss
port         = 8101            # kisshub ([server] port in kisshub.conf); host always 127.0.0.1,
                               # status port + 1. Bit rate, TXDELAY, AX.25 values from kisshub

[ax25]                         # OPTIONAL, only with interface = kiss - only to override
version      = 2.2             # 2.2: SABME/SREJ/XID, falls back to 2.0 by itself; 2.0: SABM only
# v20_digis  = OE3XTC-5        # digis that know only v2.0 (modulo 8, e.g. TM-D710E): links
#                              # over them use v2.0, all other digis count as v2.2
# v20_digi_paclen = 128        # longest I frame over such a digi (TM-D710E: 256 no, 128 yes)
# paclen / maxframe / maxframe_ext / n2 / t1_min_sec / t1_max_sec / t2_sec / t3_sec
#                              # default: from kisshub (1200 Bd: 256 / 4 / 7 / 10 / 3 / 30 / 1.5)
# srej       = yes

[web]
host         = 0.0.0.0         # 0.0.0.0 = reachable in the LAN (no login! see PLANUNG.md 11/5)
port         = 7744

[sync]
# Mailbox sync over radio, easy on the channel: each request asks for about
# chunk_bytes, then the client pauses pause_sec (longer while others are heard).
chunk_bytes  = 1024
pause_sec    = 5
# CR40: after every login the client fetches the headers of your mail and of
# the subscribed rubrics (on_login = no: only with the Sync button). Texts come
# when you click a header; only personal mail up to short_bytes comes along at
# once (256 = one frame, about 2 s at 1200 Bd; 0 = never).
on_login     = yes
short_bytes  = 256

[images]
# Pictures in the chat (CR12) go to the radio in one go; the AX.25 window
# (PACLEN 256, MAXFRAME 4, EMAXFRAME 6 - see PLANUNG.md 12.10a) paces them and
# leaves gaps for other stations. target_bytes is the size the picture is
# shrunk to ("normal" in the dialog; "small" = half, "large" = the board's limit).
target_bytes  = 4096
# bytes_per_sec =              # only for the time estimate before sending; default: 70 % of
                               # the bit rate (1200 Bd: ~105, VARA FM: ~30); then measured

[storage]
data_dir     = data/tbclient   # settings, mailbox, pictures; relative to this file
