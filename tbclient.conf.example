# TinyBox client - copy to tbclient.conf and adapt.
# Start with tbclient.bat, then open http://<this PC>:7744 in a browser (also on the phone).

[station]
mycall       = OE3GAS          # your call, with SSID if wanted (OE3GAS-9 = mobile)
locator      =                 # your locator for the ADIF export of the connection log, e.g. JN88EP
                               # (the frequency is asked when the client starts)

[tinybox]
call         = OE3GAS-1        # your TinyBox (mailbox); other stations: "Connect to" in the top bar
link         = agw             # agw = radio via Direwolf; kiss = KISS TNC via kisshub, the client's
                               # own AX.25 (no Direwolf needed); telnet = TinyBox test port (same PC)
ui           = auto            # chat events as UI frames: auto = if the TinyBox is heard directly
auto_connect = no              # connect when the client starts
telnet_host  = 127.0.0.1
telnet_port  = 6300

[direwolf]
agw_host     = 127.0.0.1
agw_port     = 8000            # AGWPORT in direwolf.conf
radio_port   = 0               # Direwolf channel

[kiss]
# only with link = kiss (CR46): kisshub owns the TNC, the client runs its own AX.25.
# kisshub listens on loopback only: client and kisshub on the PC with the TNC.
host         = 127.0.0.1
port         = 8101            # [server] port in kisshub.conf
status_port  = 8102            # kisshub status: which TNC, ready or not (0 = off)
channel      = 0               # KISS port number in the stream
air_baud     = 1200            # radio bit rate (own transmit time, T1)
txdelay_ms   = 300             # as set in kisshub.conf

[ax25]
# only with link = kiss - the same values as [ax25] of the TinyBox
version      = 2.2             # 2.2: SABME/SREJ/XID, falls back to 2.0 by itself; 2.0: SABM only
paclen       = 128             # info bytes per I frame
maxframe     = 4               # window modulo 8 (1..7)
maxframe_ext = 7               # window modulo 128 (v2.2)
srej         = yes
n2           = 10              # retries
t1_min_sec   = 3               # T1 adapts itself between these limits
t1_max_sec   = 30
t2_sec       = 1.5             # acknowledge after the other station's burst
t3_sec       = 300             # check an idle link after n seconds

[web]
host         = 0.0.0.0         # 0.0.0.0 = reachable in the LAN (no login! see PLANUNG.md 11/5)
port         = 7744

[sync]
# Mailbox sync over radio, easy on the channel: each request asks for about
# chunk_bytes, then the client pauses pause_sec (longer while others are heard).
chunk_bytes  = 1024
pause_sec    = 5
# CR40: after every login the client fetches the headers of your mail and of
# the subscribed rubrics (on_login = no: only with the Sync button). Texts come
# when you click a header; only personal mail up to short_bytes comes along at
# once (256 = one frame, about 2 s at 1200 Bd; 0 = never).
on_login     = yes
short_bytes  = 256

[images]
# Pictures in the chat (CR12) go to Direwolf in one go; the AX.25 window in
# direwolf.conf (PACLEN 256, MAXFRAME 4, EMAXFRAME 6 - see PLANUNG.md 12.10a)
# paces them and leaves gaps for other stations. target_bytes is the size the
# picture is shrunk to ("normal" in the dialog; "small" = half, "large" = the
# board's limit). bytes_per_sec is only for the time estimate shown before
# sending (1200 Bd with 256-byte frames and a window of 6 is about 100-120).
target_bytes  = 4096
bytes_per_sec = 100

[storage]
data_dir     = data/tbclient   # settings, mailbox, pictures; relative to this file
