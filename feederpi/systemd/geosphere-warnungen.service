[Unit]
Description=Feeder-Pi: GeoSphere weather warnings into the outbox
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
User=tinybox
Group=tinybox
WorkingDirectory=/opt/tinybox
EnvironmentFile=-/etc/default/feederpi
Environment=PYTHONDONTWRITEBYTECODE=1
# result: NAME.txt in /run/tinybox/ausgang (RAM), fetched by the PC (pi_abholung.py)
ExecStart=/usr/bin/python3 /opt/tinybox/geosphere_warnungen.py --tinybox /run/tinybox/ausgang
TimeoutStartSec=300
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/tinybox /run/tinybox/ausgang
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
