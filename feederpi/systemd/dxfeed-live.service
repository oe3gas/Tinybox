[Unit]
Description=Feeder-Pi: dxfeed live (DX jetzt, Baender jetzt, Neu auf dem Band)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
User=tinybox
Group=tinybox
WorkingDirectory=/opt/tinybox
EnvironmentFile=-/etc/default/feederpi
Environment=PYTHONDONTWRITEBYTECODE=1
# result: NAME.txt in /run/tinybox/ausgang (RAM), fetched by the PC (pi_abholung.py);
# state in /opt/tinybox/data/dxfeed-live.json, written only when it changes
ExecStart=/usr/bin/python3 -m dxfeed -c /opt/tinybox/dxfeed.conf live --tinybox /run/tinybox/ausgang
TimeoutStartSec=120
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/tinybox /run/tinybox/ausgang
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
