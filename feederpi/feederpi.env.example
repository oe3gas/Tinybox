# Feeder-Pi settings, installed as /etc/default/feederpi (read by the systemd units).
# pi_sd_vorbereiten.py writes feederpi.env from this template.
# A change on the Pi takes effect at the next run (no restart needed).

# Locator(s) for the GeoSphere forecast, several separated by commas (no spaces)
LOCATOR=JN88BN
